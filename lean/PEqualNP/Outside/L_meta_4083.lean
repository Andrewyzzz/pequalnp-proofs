lemma extended_list (x : Fin 10 → Bool) :
    List.ofFn (extended x)=List.ofFn x++[!x 0] := by
  apply List.ext_getElem
  · simp
  · intro i hi hj
    by_cases h : i<10
    · simp [extended,h,List.getElem_append_left]
    · have he : i=10 := by simp only [List.length_ofFn] at hi; omega
      subst i
      simp [extended]

