set_option maxHeartbeats 0 in
lemma extended_mix_inside (S : Finset (Fin 10)) (A : Finset Nat)
    (ha : ∀ i : Fin 10, i.val ∈ A ↔ i ∈ S) (hcomp : 10 ∈ A ↔ (0 : Fin 10) ∈ S)
    (x z : Fin 10 → Bool) : ∀ i : Fin 11, i.val ∈ A → extended (mix S x z) i=extended x i := by
  intro i hi
  by_cases h : i.val<10
  · simp [extended,h,mix,(ha ⟨i.val,h⟩).mp hi]
  · have he : i.val=10 := by have := i.isLt; omega
    have hz := hcomp.mp (he ▸ hi)
    simp [extended,h,mix,hz]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma extended_mix_outside (S : Finset (Fin 10)) (A : Finset Nat)
    (ha : ∀ i : Fin 10, i.val ∈ A ↔ i ∈ S) (hcomp : 10 ∈ A ↔ (0 : Fin 10) ∈ S)
    (x z : Fin 10 → Bool) : ∀ i : Fin 11, i.val ∉ A → extended (mix S x z) i=extended z i := by
  intro i hi
  by_cases h : i.val<10
  · have hz : (⟨i.val,h⟩ : Fin 10) ∉ S := fun hx => hi ((ha _).mpr hx)
    simp [extended,h,mix,hz]
  · have he : i.val=10 := by have := i.isLt; omega
    have hz : (0 : Fin 10) ∉ S := fun hx => hi (he ▸ hcomp.mpr hx)
    simp [extended,h,mix,hz]

