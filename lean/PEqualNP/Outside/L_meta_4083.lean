lemma outside_agree {n : Nat} (C : Circuit) (A B : Finset Nat)
    (cross : ∀ j g, C.gates[j]?=some g → n+j ∉ A → ∀ i ∈ g.inputs, i ∈ A → i ∈ B)
    (x y : Fin n → Bool) (inputs : ∀ i : Fin n, i.val ∉ A → x i=y i)
    (boundary : ∀ w ∈ A, w ∈ B → val C x w=val C y w) :
    ∀ w, w ∉ A → val C x w=val C y w := by
  intro w
  induction w using Nat.strong_induction_on with
  | ind w ih =>
    intro hw
    by_cases hn : w<n
    · exact (val_input C x ⟨w,hn⟩).trans ((inputs ⟨w,hn⟩ hw).trans (val_input C y ⟨w,hn⟩).symm)
    by_cases hr : w<n+C.gates.length
    swap
    · exact (val_beyond C x (by omega)).trans (val_beyond C y (by omega)).symm
    obtain ⟨j,hj,rfl⟩ : ∃ j, j<C.gates.length ∧ w=n+j := ⟨w-n,by omega,by omega⟩
    let g := C.gates[j]
    have hg : C.gates[j]?=some g := List.getElem?_eq_some_iff.mpr ⟨hj,rfl⟩
    rw [val_gate C x hg,val_gate C y hg]
    apply congrArg g.op.eval
    apply List.map_congr_left
    intro i hi
    by_cases hback : i<n+j
    · simp only [operand,ite_eq_left hback]
      by_cases ha : i ∈ A
      · exact boundary i ha (cross j g hg hw i hi ha)
      · exact ih i hback ha
    · simp [operand,hback]

