set_option maxHeartbeats 0 in
lemma cut_splice (C : Circuit) (S : Finset (Fin 10)) (A B : Finset Nat)
    (ha : ∀ i : Fin 10, i.val ∈ A ↔ i ∈ S) (hcomp : 10 ∈ A ↔ (0 : Fin 10) ∈ S)
    (gates : ∀ j : Fin C.size, ∀ i ∈ (C.gates.get j).inputs,
      (11+j.val ∈ A → i ∈ A) ∧ (11+j.val ∉ A → i ∈ A → i ∈ B))
    (out : C.output ∈ A → C.output ∈ B)
    (x y : Fin 10 → Bool)
    (same : ∀ w ∈ B, val C (extended x) w=val C (extended y) w) :
    ∀ z : Fin 10 → Bool,
      val C (extended (mix S x z)) C.output=val C (extended (mix S y z)) C.output := by
  have view (j : Nat) (g : Gate) (hg : C.gates[j]?=some g) :
      ∀ i ∈ g.inputs, (11+j ∈ A → i ∈ A) ∧ (11+j ∉ A → i ∈ A → i ∈ B) := by
    obtain ⟨hj,hg'⟩ := List.getElem?_eq_some_iff.mp hg
    have h := gates ⟨j,hj⟩
    change ∀ i ∈ C.gates[j].inputs, _ at h
    rw [hg'] at h
    exact h
  have closed : ∀ j g, C.gates[j]?=some g → 11+j ∈ A → ∀ i ∈ g.inputs, i ∈ A :=
    fun j g hg hj i hi => (view j g hg i hi).1 hj
  have cross : ∀ j g, C.gates[j]?=some g → 11+j ∉ A → ∀ i ∈ g.inputs, i ∈ A → i ∈ B :=
    fun j g hg hj i hi => (view j g hg i hi).2 hj
  intro z
  have boundary : ∀ w ∈ A, w ∈ B →
      val C (extended (mix S x z)) w=val C (extended (mix S y z)) w := by
    intro w hw hb
    exact (inside_agree C A closed _ _ (extended_mix_inside S A ha hcomp x z) w hw).trans
      ((same w hb).trans (inside_agree C A closed _ _ (extended_mix_inside S A ha hcomp y z) w hw).symm)
  by_cases ho : C.output ∈ A
  · exact boundary _ ho (out ho)
  · apply outside_agree C A B cross _ _ _ boundary C.output ho
    intro i hi
    exact (extended_mix_outside S A ha hcomp x z i hi).trans
      (extended_mix_outside S A ha hcomp y z i hi).symm

