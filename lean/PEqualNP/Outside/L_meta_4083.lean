lemma maskMix_bound (s x z : Fin 1024) : maskMix s.val x.val z.val < 1024 := by
  have hc : 1023 ^^^ s.val < 1024 := Nat.xor_lt_two_pow (n := 10) (by decide) s.isLt
  exact Nat.or_lt_two_pow (n := 10) (Nat.and_lt_two_pow x.val (n := 10) s.isLt) (Nat.and_lt_two_pow z.val (n := 10) hc)
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma probe_bound (j : Fin 11) : probe j < 1024 := by revert j; decide +kernel
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma decode_maskMix (s x z : Fin 1024) :
    decode ⟨maskMix s.val x.val z.val,maskMix_bound s x z⟩=mix (subset s) (decode x) (decode z) := by
  funext i
  rw [decode,maskMix_bits]
  have hm : i ∈ subset s ↔ decode s i=true := by
    change i ∈ Finset.univ.filter (fun j => decode s j=true) ↔ _
    simp only [Finset.mem_filter,Finset.mem_univ,true_and]
  change (if decode s i=true then decode x i else decode z i) =
    (if i ∈ subset s then decode x i else decode z i)
  by_cases hi : i ∈ subset s
  · rw [ite_eq_left hi,ite_eq_left (hm.mp hi)]
  · rw [ite_eq_right hi,ite_eq_right (fun hx => hi (hm.mpr hx))]
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma subset_surj (S : Finset (Fin 10)) : ∃ s : Fin 1024, subset s=S := by
  obtain ⟨s,hs⟩ := decode_surj (fun i => decide (i∈S))
  refine ⟨s,?_⟩
  ext i
  simp [subset,hs]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma val_extended (C : Circuit) (x : Fin 10 → Bool) (w : Nat) :
    val C (extended x) w=(C.wires (List.ofFn x++[!x 0])).getD w false := by
  simp only [val,extended_list,wiresFrom,Circuit.wires]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma lower_from_witnesses (C : Circuit)
    (hc : ∀ x : Fin 10 → Bool, C.eval (List.ofFn x++[!x 0])=graphF x)
    (s : Fin 1024) (A B : Finset Nat)
    (ha : ∀ i : Fin 10, i.val ∈ A ↔ i ∈ subset s) (hcomp : 10 ∈ A ↔ (0 : Fin 10) ∈ subset s)
    (gates : ∀ j : Fin C.size, ∀ i ∈ (C.gates.get j).inputs,
      (11+j.val ∈ A → i ∈ A) ∧ (11+j.val ∉ A → i ∈ A → i ∈ B))
    (out : C.output ∈ A → C.output ∈ B)
    (k : Nat) (w : Fin k → Fin 1024) (key : Fin k → Fin 2048)
    (ki : Function.Injective key)
    (correct : ∀ (i : Fin k) (j : Fin 11),
      graphF (mix (subset s) (decode (w i)) (decode ⟨probe j,probe_bound j⟩))=(key i).val.testBit j.val) :
    k ≤ (Finset.image (fun (x : Fin 10 → Bool) (b : ↥B) =>
      (C.wires (List.ofFn x++[!x 0])).getD b.val false) Finset.univ).card := by
  let boundary := fun (x : Fin 10 → Bool) (b : ↥B) =>
      (C.wires (List.ofFn x++[!x 0])).getD b.val false
  let image := Finset.image boundary Finset.univ
  let f : Fin k → ↥image := fun i => ⟨boundary (decode (w i)),Finset.mem_image.mpr ⟨decode (w i),Finset.mem_univ _,rfl⟩⟩
  have fi : Function.Injective f := by
    intro a b hab
    have he : boundary (decode (w a))=boundary (decode (w b)) := congrArg Subtype.val hab
    have same : ∀ v ∈ B, val C (extended (decode (w a))) v=val C (extended (decode (w b))) v := by
      intro v hv
      simpa only [val_extended] using congrFun he ⟨v,hv⟩
    have splice := cut_splice C (subset s) A B ha hcomp gates out _ _ same
    apply ki
    apply Fin.ext
    apply Nat.eq_of_testBit_eq
    intro j
    by_cases hj : j<11
    · have hs := splice (decode ⟨probe ⟨j,hj⟩,probe_bound ⟨j,hj⟩⟩)
      simp only [val_extended] at hs
      change C.eval _=C.eval _ at hs
      rw [hc,hc,correct a ⟨j,hj⟩,correct b ⟨j,hj⟩] at hs
      exact hs
    · have hp : 2048 ≤ 2^j := Nat.pow_le_pow_right (by omega : 0<2) (by omega : 11 ≤ j)
      rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le (key a).isLt hp),Nat.testBit_lt_two_pow (lt_of_lt_of_le (key b).isLt hp)]
  have hcard := Fintype.card_le_of_injective f fi
  simpa only [Fintype.card_fin,Fintype.card_coe] using hcard

